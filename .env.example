# Copy this file to .env and fill in your real values. Never commit .env.

# --- Database (Neon Postgres) ---
# Get this from your Neon project dashboard: Connection Details > Connection string
# It must include "?sslmode=require" (Neon requires SSL).
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require

# --- App ---
PORT=3000
NODE_ENV=development

# --- Company contact details shown in the footer / contact page ---
COMPANY_PHONE=+91 79 XXXX XXXX
COMPANY_WHATSAPP=+91 98XXXXXXXX
COMPANY_EMAIL=info@techfluidindustries.com
COMPANY_ADDRESS=32, Victoria Industrial Park, Kathwada GIDC, Ahmedabad, Gujarat, India

# --- Admin panel (/admin) — view, update, and delete RFQ leads ---
# Pick a strong password; this protects real customer contact data.
ADMIN_PASSWORD=change-me-before-deploying
# Any long random string — used to sign admin login session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_APP_SECRET=change-me-to-a-random-string
