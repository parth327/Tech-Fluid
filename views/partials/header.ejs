<header class="site-header" id="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label="Tech Fluid Industries — home">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34">
          <rect x="4" y="15" width="18" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="2.5"/>
          <rect x="22" y="18" width="12" height="4" fill="currentColor"/>
          <rect x="34" y="16" width="4" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="2.5"/>
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">Tech Fluid <em>Industries</em></span>
        <span class="brand__tag">Est. 2009 &middot; Ahmedabad</span>
      </span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <ul>
        <li><a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Home</a></li>
        <li><a href="/about" class="<%= currentPath === '/about' ? 'is-active' : '' %>">About Us</a></li>
        <li><a href="/products" class="<%= currentPath === '/products' ? 'is-active' : '' %>">Products</a></li>
        <li><a href="/applications" class="<%= currentPath === '/applications' ? 'is-active' : '' %>">Applications</a></li>
        <li><a href="/quality" class="<%= currentPath === '/quality' ? 'is-active' : '' %>">Quality</a></li>
        <li><a href="/contact" class="<%= currentPath === '/contact' ? 'is-active' : '' %>">Contact</a></li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/contact" class="btn btn--amber btn--sm">
        Request a Quote
        <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-arrow-right"/></svg>
      </a>
      <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation menu">
        <svg class="icon" aria-hidden="true"><use href="#icon-menu"/></svg>
      </button>
    </div>
  </div>
</header>
