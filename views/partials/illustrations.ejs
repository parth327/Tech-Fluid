<svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">

  <!-- ============ Cylinder — detailed illustration ============ -->
  <symbol id="illus-cylinder" viewBox="0 0 320 190">
    <ellipse cx="160" cy="172" rx="130" ry="10" fill="#0F172A" opacity="0.08"/>
    <!-- mounting flange -->
    <rect x="26" y="66" width="16" height="60" rx="2" fill="#1E293B" stroke="#F97316" stroke-width="2"/>
    <circle cx="34" cy="76" r="2.2" fill="#94A3B8"/>
    <circle cx="34" cy="116" r="2.2" fill="#94A3B8"/>
    <!-- barrel -->
    <rect x="42" y="52" width="150" height="88" rx="12" fill="#17233B" stroke="#F97316" stroke-width="2.5"/>
    <rect x="56" y="62" width="122" height="10" rx="5" fill="#FFFFFF" opacity="0.06"/>
    <!-- weld seam + bolts -->
    <line x1="42" y1="96" x2="192" y2="96" stroke="#0F172A" stroke-width="1" opacity="0.4" stroke-dasharray="2 3"/>
    <circle cx="58" cy="58" r="2" fill="#334155"/>
    <circle cx="176" cy="58" r="2" fill="#334155"/>
    <circle cx="58" cy="134" r="2" fill="#334155"/>
    <circle cx="176" cy="134" r="2" fill="#334155"/>
    <!-- port fitting -->
    <rect x="100" y="40" width="14" height="12" rx="2" fill="#334155"/>
    <circle cx="107" cy="40" r="3.5" fill="none" stroke="#94A3B8" stroke-width="1.5"/>
    <!-- piston + rod -->
    <rect x="160" y="58" width="14" height="76" fill="#F97316"/>
    <rect x="174" y="86" width="112" height="22" fill="url(#rodGrad2)"/>
    <rect x="174" y="86" width="112" height="5" fill="#FFFFFF" opacity="0.35"/>
    <rect x="188" y="52" width="8" height="88" fill="#0F172A" opacity="0.5"/>
    <!-- rod clevis -->
    <rect x="278" y="82" width="12" height="30" rx="3" fill="#1E293B" stroke="#94A3B8" stroke-width="2"/>
    <circle cx="284" cy="97" r="4" fill="none" stroke="#94A3B8" stroke-width="1.75"/>
    <defs>
      <linearGradient id="rodGrad2" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#E2E8F0"/>
        <stop offset="50%" stop-color="#94A3B8"/>
        <stop offset="100%" stop-color="#64748B"/>
      </linearGradient>
    </defs>
  </symbol>

  <!-- ============ Power Pack — detailed illustration ============ -->
  <symbol id="illus-powerpack" viewBox="0 0 320 190">
    <ellipse cx="160" cy="172" rx="130" ry="10" fill="#0F172A" opacity="0.08"/>
    <!-- reservoir tank -->
    <rect x="30" y="76" width="120" height="70" rx="6" fill="#17233B" stroke="#F97316" stroke-width="2.5"/>
    <rect x="40" y="86" width="10" height="50" rx="3" fill="none" stroke="#94A3B8" stroke-width="1.25" opacity="0.6"/>
    <line x1="45" y1="94" x2="45" y2="128" stroke="#F97316" stroke-width="2" opacity="0.7"/>
    <circle cx="120" cy="92" r="12" fill="none" stroke="#94A3B8" stroke-width="2"/>
    <line x1="120" y1="92" x2="126" y2="85" stroke="#F97316" stroke-width="2" stroke-linecap="round"/>
    <!-- base skid -->
    <rect x="24" y="146" width="132" height="10" rx="2" fill="#1E293B" stroke="#334155" stroke-width="1.5"/>
    <!-- motor + pump -->
    <circle cx="205" cy="90" r="38" fill="#17233B" stroke="#F97316" stroke-width="2.5"/>
    <circle cx="205" cy="90" r="27" fill="none" stroke="#334155" stroke-width="1.5"/>
    <circle cx="205" cy="90" r="7" fill="#F97316"/>
    <g stroke="#94A3B8" stroke-width="2" opacity="0.7">
      <line x1="205" y1="58" x2="205" y2="66"/>
      <line x1="205" y1="114" x2="205" y2="122"/>
      <line x1="173" y1="90" x2="181" y2="90"/>
      <line x1="229" y1="90" x2="237" y2="90"/>
    </g>
    <rect x="150" y="86" width="16" height="10" fill="#334155"/>
    <!-- valve bank on top of tank -->
    <rect x="55" y="60" width="70" height="18" rx="2" fill="#1E293B" stroke="#94A3B8" stroke-width="1.5"/>
    <circle cx="66" cy="69" r="4" fill="none" stroke="#F97316" stroke-width="1.75"/>
    <circle cx="84" cy="69" r="4" fill="none" stroke="#F97316" stroke-width="1.75"/>
    <circle cx="102" cy="69" r="4" fill="none" stroke="#F97316" stroke-width="1.75"/>
    <!-- pipe connecting pump to valve bank -->
    <path d="M243 90 H264 V60 H125" fill="none" stroke="#F97316" stroke-width="2" stroke-dasharray="5 5" opacity="0.75"/>
  </symbol>

  <!-- ============ Jack — detailed illustration ============ -->
  <symbol id="illus-jack" viewBox="0 0 320 190">
    <ellipse cx="160" cy="172" rx="110" ry="10" fill="#0F172A" opacity="0.08"/>
    <!-- base -->
    <path d="M96 146 H224 L206 168 H114 Z" fill="#17233B" stroke="#F97316" stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="112" cy="157" r="2.2" fill="#94A3B8"/>
    <circle cx="208" cy="157" r="2.2" fill="#94A3B8"/>
    <!-- body -->
    <rect x="140" y="70" width="40" height="78" rx="4" fill="#1E293B" stroke="#94A3B8" stroke-width="2"/>
    <!-- pump lever socket -->
    <rect x="176" y="96" width="16" height="10" rx="2" fill="#334155"/>
    <line x1="192" y1="101" x2="224" y2="88" stroke="#94A3B8" stroke-width="4" stroke-linecap="round"/>
    <!-- release valve knob -->
    <circle cx="148" cy="120" r="5" fill="none" stroke="#F97316" stroke-width="2"/>
    <!-- ram -->
    <rect x="150" y="34" width="20" height="42" fill="#F97316"/>
    <!-- saddle -->
    <rect x="138" y="24" width="44" height="12" rx="2" fill="none" stroke="#F97316" stroke-width="2.5"/>
    <!-- brand plate -->
    <rect x="146" y="128" width="28" height="10" rx="1.5" fill="none" stroke="#94A3B8" stroke-width="1.25" opacity="0.7"/>
  </symbol>

  <!-- ============ Manufacturing facility — workshop scene ============ -->
  <symbol id="illus-facility" viewBox="0 0 900 380">
    <!-- floor -->
    <rect x="0" y="300" width="900" height="80" fill="#111C33"/>
    <g stroke="#1E293B" stroke-width="1.5" opacity="0.6">
      <line x1="0" y1="320" x2="900" y2="320"/>
      <line x1="0" y1="345" x2="900" y2="345"/>
    </g>
    <rect x="40" y="332" width="200" height="8" fill="#F97316" opacity="0.75"/>
    <rect x="40" y="332" width="200" height="8" fill="none" stroke="#0F172A" stroke-width="1" stroke-dasharray="10 6"/>

    <!-- back wall + roof trusses -->
    <rect x="0" y="0" width="900" height="300" fill="#0B1526"/>
    <g stroke="#1E293B" stroke-width="2">
      <path d="M0 60 L120 10 L240 60" fill="none"/>
      <path d="M240 60 L360 10 L480 60" fill="none"/>
      <path d="M480 60 L600 10 L720 60" fill="none"/>
      <path d="M720 60 L840 10 L900 34" fill="none"/>
      <line x1="0" y1="60" x2="900" y2="60"/>
    </g>
    <!-- skylight glow -->
    <rect x="90" y="18" width="60" height="8" fill="#F97316" opacity="0.35"/>
    <rect x="450" y="18" width="60" height="8" fill="#F97316" opacity="0.35"/>

    <!-- gantry crane rail -->
    <line x1="60" y1="90" x2="840" y2="90" stroke="#334155" stroke-width="4"/>
    <rect x="230" y="84" width="46" height="12" rx="2" fill="#17233B" stroke="#F97316" stroke-width="2"/>
    <line x1="253" y1="96" x2="253" y2="150" stroke="#94A3B8" stroke-width="3"/>
    <path d="M244 150 h18 l-9 14 z" fill="#F97316"/>

    <!-- featured cylinder on workbench -->
    <rect x="190" y="230" width="140" height="16" fill="#1E293B"/>
    <rect x="200" y="246" width="16" height="54" fill="#17233B"/>
    <rect x="304" y="246" width="16" height="54" fill="#17233B"/>
    <rect x="205" y="196" width="110" height="46" rx="8" fill="#17233B" stroke="#F97316" stroke-width="2.25"/>
    <rect x="300" y="210" width="70" height="16" fill="#94A3B8"/>
    <rect x="300" y="210" width="70" height="4" fill="#FFFFFF" opacity="0.35"/>
    <rect x="120" y="214" width="10" height="70" fill="#1E293B" stroke="#F97316" stroke-width="1.5"/>

    <!-- raw stock bundle, left -->
    <g stroke="#334155" stroke-width="2" fill="#17233B">
      <circle cx="55" cy="272" r="12"/>
      <circle cx="78" cy="272" r="12"/>
      <circle cx="66" cy="252" r="12"/>
    </g>

    <!-- lathe silhouette, back left -->
    <rect x="470" y="228" width="130" height="14" fill="#1E293B"/>
    <rect x="480" y="204" width="110" height="26" rx="3" fill="#17233B" stroke="#334155" stroke-width="2"/>
    <circle cx="495" cy="217" r="9" fill="none" stroke="#F97316" stroke-width="2"/>
    <line x1="512" y1="217" x2="580" y2="217" stroke="#94A3B8" stroke-width="3"/>

    <!-- stacked finished jacks, right -->
    <g fill="#17233B" stroke="#F97316" stroke-width="1.75">
      <rect x="700" y="252" width="34" height="24" rx="2"/>
      <rect x="700" y="226" width="34" height="24" rx="2"/>
      <rect x="742" y="252" width="34" height="24" rx="2"/>
    </g>

    <!-- forklift silhouette, far right -->
    <g stroke="#334155" stroke-width="3" fill="none">
      <rect x="808" y="238" width="46" height="34" rx="2" fill="#111C33"/>
      <circle cx="816" cy="278" r="8" fill="#0B1526"/>
      <circle cx="846" cy="278" r="8" fill="#0B1526"/>
      <line x1="858" y1="222" x2="858" y2="272"/>
      <line x1="858" y1="228" x2="882" y2="228"/>
      <line x1="858" y1="248" x2="882" y2="248"/>
    </g>
  </symbol>

</svg>
