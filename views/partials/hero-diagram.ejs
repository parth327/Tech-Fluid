<svg viewBox="0 0 600 460" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Cross-section diagram of a hydraulic cylinder showing bore and stroke dimensions, with a pressure gauge reading rated working pressure">
  <defs>
    <linearGradient id="rodGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#E2E8F0"/>
      <stop offset="45%" stop-color="#94A3B8"/>
      <stop offset="100%" stop-color="#64748B"/>
    </linearGradient>
    <marker id="arrowAmber" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M1 1 L9 5 L1 9 Z" fill="#F97316"/>
    </marker>
  </defs>

  <!-- ============ pressure gauge ============ -->
  <g class="diag-fade" style="--d:.15s">
    <circle cx="98" cy="96" r="56" fill="#17233B" stroke="#F97316" stroke-width="2.5"/>
    <circle cx="98" cy="96" r="46" fill="none" stroke="#334155" stroke-width="1"/>
    <!-- ticks -->
    <g stroke="#94A3B8" stroke-width="1.5">
      <line x1="98" y1="54" x2="98" y2="60"/>
      <line x1="132" y1="70" x2="127" y2="74"/>
      <line x1="145" y1="96" x2="139" y2="96"/>
      <line x1="132" y1="122" x2="127" y2="118"/>
      <line x1="64" y1="70" x2="69" y2="74"/>
      <line x1="51" y1="96" x2="57" y2="96"/>
      <line x1="64" y1="122" x2="69" y2="118"/>
    </g>
    <!-- needle -->
    <g class="diag-gauge-needle" style="--gx:98px; --gy:96px;">
      <line x1="98" y1="96" x2="98" y2="58" stroke="#F97316" stroke-width="3" stroke-linecap="round"/>
    </g>
    <circle cx="98" cy="96" r="5.5" fill="#F97316"/>
    <text x="98" y="170" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="15" font-weight="600" fill="#FFFFFF">3,000 PSI</text>
    <text x="98" y="188" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="1.5" fill="#94A3B8">RATED WORKING PRESSURE</text>
  </g>

  <!-- ============ flow line: gauge to barrel port ============ -->
  <path class="diag-flow" d="M98 152 V196 H150 V213" fill="none" stroke="#F97316" stroke-width="2" opacity="0.8"/>

  <!-- ============ cylinder assembly ============ -->
  <!-- mounting flange -->
  <g class="diag-fade" style="--d:.35s">
    <rect x="118" y="222" width="16" height="86" rx="2" fill="#1E293B" stroke="#FDBA74" stroke-width="2"/>
    <line x1="122" y1="222" x2="122" y2="308" stroke="#0F172A" stroke-width="1" opacity="0.4"/>
  </g>

  <!-- barrel -->
  <g class="diag-fade" style="--d:.42s">
    <rect x="134" y="207" width="230" height="116" rx="10" fill="#17233B" stroke="#F97316" stroke-width="2.5"/>
    <rect x="146" y="219" width="206" height="8" rx="4" fill="#FFFFFF" opacity="0.05"/>
  </g>

  <!-- piston head + rod -->
  <g class="diag-fade" style="--d:.55s">
    <rect x="300" y="216" width="16" height="98" fill="#F97316"/>
    <rect x="316" y="250" width="210" height="30" fill="url(#rodGrad)"/>
    <rect x="316" y="250" width="210" height="6" fill="#FFFFFF" opacity="0.35"/>
    <!-- gland -->
    <rect x="352" y="207" width="10" height="116" fill="#0F172A" opacity="0.55"/>
    <!-- rod clevis -->
    <rect x="526" y="242" width="14" height="46" rx="3" fill="#1E293B" stroke="#94A3B8" stroke-width="2"/>
    <circle cx="533" cy="265" r="5" fill="none" stroke="#94A3B8" stroke-width="2"/>
  </g>

  <!-- ============ dimension: BORE (vertical) ============ -->
  <g class="diag-fade" style="--d:.75s">
    <line x1="94" y1="207" x2="94" y2="323" stroke="#94A3B8" stroke-width="1" stroke-dasharray="2 3"/>
    <line class="diag-draw" style="--len:118; --d:.8s" x1="94" y1="211" x2="94" y2="319"
          stroke="#F97316" stroke-width="1.75" marker-start="url(#arrowAmber)" marker-end="url(#arrowAmber)"/>
    <text x="80" y="265" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="12" font-weight="600" fill="#FFFFFF" transform="rotate(-90 80 265)">BORE &#216; 100 MM</text>
  </g>

  <!-- ============ dimension: STROKE (horizontal) ============ -->
  <g class="diag-fade" style="--d:.9s">
    <line x1="150" y1="356" x2="150" y2="368" stroke="#94A3B8" stroke-width="1"/>
    <line x1="526" y1="356" x2="526" y2="368" stroke="#94A3B8" stroke-width="1"/>
    <line class="diag-draw" style="--len:376; --d:.95s" x1="154" y1="362" x2="522" y2="362"
          stroke="#F97316" stroke-width="1.75" marker-start="url(#arrowAmber)" marker-end="url(#arrowAmber)"/>
    <text x="338" y="386" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="12" font-weight="600" fill="#FFFFFF">STROKE — 450 MM</text>
  </g>

  <!-- ============ title block (engineering drawing motif) ============ -->
  <g class="diag-fade" style="--d:1.1s">
    <rect x="368" y="30" width="208" height="86" fill="none" stroke="#334155" stroke-width="1.25"/>
    <line x1="368" y1="56" x2="576" y2="56" stroke="#334155" stroke-width="1"/>
    <line x1="368" y1="82" x2="576" y2="82" stroke="#334155" stroke-width="1"/>
    <line x1="480" y1="56" x2="480" y2="116" stroke="#334155" stroke-width="1"/>
    <text x="378" y="47" font-family="JetBrains Mono, monospace" font-size="11" font-weight="600" fill="#FDBA74">TFI&#8209;CYL&#8209;450&#8209;DA</text>
    <text x="378" y="73" font-family="JetBrains Mono, monospace" font-size="8.5" fill="#94A3B8">MATERIAL: ALLOY STL</text>
    <text x="378" y="99" font-family="JetBrains Mono, monospace" font-size="8.5" fill="#94A3B8">SEAL: PU / NBR</text>
    <text x="490" y="73" font-family="JetBrains Mono, monospace" font-size="8.5" fill="#94A3B8">SCALE: NTS</text>
    <text x="490" y="99" font-family="JetBrains Mono, monospace" font-size="8.5" fill="#94A3B8">DOUBLE-ACT</text>
  </g>
</svg>
