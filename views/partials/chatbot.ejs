<div class="chatbot" id="chatbot">
  <button type="button" class="chatbot-bubble" id="chatbot-bubble" aria-expanded="false" aria-controls="chatbot-panel" aria-label="Chat with Tech Fluid Industries">
    <svg class="icon icon--lg chatbot-bubble__icon-open" aria-hidden="true"><use href="#icon-chat"/></svg>
    <svg class="icon icon--lg chatbot-bubble__icon-close" aria-hidden="true"><use href="#icon-close"/></svg>
  </button>

  <div class="chatbot-panel" id="chatbot-panel" hidden>
    <div class="chatbot-panel__header">
      <div class="chatbot-panel__brand">
        <span class="chatbot-panel__avatar">
          <svg viewBox="0 0 40 40" width="20" height="20">
            <rect x="4" y="15" width="18" height="10" rx="1.5" fill="none" stroke="#0F172A" stroke-width="2.5"/>
            <rect x="22" y="18" width="12" height="4" fill="#0F172A"/>
            <rect x="34" y="16" width="4" height="8" rx="1" fill="none" stroke="#0F172A" stroke-width="2.5"/>
          </svg>
        </span>
        <div>
          <strong>Tech Fluid Assistant</strong>
          <span>Usually replies in a few minutes</span>
        </div>
      </div>
      <button type="button" class="chatbot-panel__close" id="chatbot-close" aria-label="Close chat">
        <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-close"/></svg>
      </button>
    </div>

    <div class="chatbot-panel__messages" id="chatbot-messages" role="log" aria-live="polite"></div>

    <div class="chatbot-panel__quick-replies" id="chatbot-quick-replies"></div>

    <form class="chatbot-panel__input" id="chatbot-form" autocomplete="off">
      <input type="text" id="chatbot-input" placeholder="Type your question…" aria-label="Type a message" maxlength="300">
      <button type="submit" aria-label="Send">
        <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-arrow-right"/></svg>
      </button>
    </form>
  </div>
</div>
