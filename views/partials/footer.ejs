<section class="cta-banner">
  <div class="wrap cta-banner__inner">
    <div>
      <p class="eyebrow eyebrow--light">Ready to spec your next system?</p>
      <h2>Tell us your bore, stroke and pressure — we'll do the rest.</h2>
    </div>
    <a href="/contact" class="btn btn--amber btn--lg">
      Get Instant Quote
      <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right"/></svg>
    </a>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-col footer-col--about">
      <a href="/" class="brand brand--footer">
        <span class="brand__mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="30" height="30">
            <rect x="4" y="15" width="18" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="2.5"/>
            <rect x="22" y="18" width="12" height="4" fill="currentColor"/>
            <rect x="34" y="16" width="4" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="2.5"/>
          </svg>
        </span>
        <span class="brand__name">Tech Fluid <em>Industries</em></span>
      </a>
      <p class="footer-col__desc">
        Precision hydraulic cylinders, power packs and lifting equipment,
        engineered and pressure-tested in Ahmedabad since 2009.
      </p>
      <a href="/brochure.pdf" class="btn btn--outline btn--sm" download>
        <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-download"/></svg>
        Download Product Brochure
      </a>
    </div>

    <div class="footer-col">
      <h3>Quick Links</h3>
      <ul class="footer-links">
        <li><a href="/about">About Us</a></li>
        <li><a href="/products">Products</a></li>
        <li><a href="/applications">Applications</a></li>
        <li><a href="/quality">Quality</a></li>
        <li><a href="/contact">Request a Quote</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Products</h3>
      <ul class="footer-links">
        <li><a href="/products?category=cylinders">Hydraulic Cylinders</a></li>
        <li><a href="/products?category=power-packs">Power Packs (HPUs)</a></li>
        <li><a href="/products?category=jacks">Jacks &amp; Lifting Equipment</a></li>
      </ul>
    </div>

    <div class="footer-col footer-col--contact">
      <h3>Contact</h3>
      <ul class="footer-contact">
        <li>
          <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-pin"/></svg>
          <span><%= company.address %></span>
        </li>
        <li>
          <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-phone"/></svg>
          <a href="tel:<%= company.phone.replace(/\s+/g,'') %>"><%= company.phone %></a>
        </li>
        <li>
          <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-mail"/></svg>
          <a href="mailto:<%= company.email %>"><%= company.email %></a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-map">
    <iframe
      title="Tech Fluid Industries location — Kathwada GIDC, Ahmedabad"
      src="https://www.google.com/maps?q=<%= encodeURIComponent(company.address) %>&output=embed"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade">
    </iframe>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> Tech Fluid Industries. All rights reserved.</p>
    <p class="footer-bottom__gidc">Kathwada GIDC, Ahmedabad, Gujarat, India</p>
    <a href="/admin" class="footer-bottom__admin">Staff Login</a>
  </div>
</footer>

<% if (currentPath !== '/contact') { %>
<div class="mobile-cta-bar" role="region" aria-label="Quick contact">
  <a href="tel:<%= company.phone.replace(/\s+/g,'') %>" class="mobile-cta-bar__btn mobile-cta-bar__btn--call">
    <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-phone"/></svg>
    Call Now
  </a>
  <a href="/contact" class="mobile-cta-bar__btn mobile-cta-bar__btn--quote">
    <svg class="icon icon--sm" aria-hidden="true"><use href="#icon-quote"/></svg>
    Get Quote
  </a>
</div>
<% } %>

<div class="float-actions">
  <button type="button" class="backtotop-fab" id="backtotop" aria-label="Back to top">
    <svg class="icon" aria-hidden="true"><use href="#icon-chevron-up"/></svg>
  </button>
  <% if (company.whatsapp) { %>
  <a
    class="whatsapp-fab"
    href="https://wa.me/<%= company.whatsapp.replace(/\D/g,'') %>?text=<%= encodeURIComponent('Hi, I\'d like a quote for a hydraulic ' ) %>"
    target="_blank" rel="noopener"
    aria-label="Chat on WhatsApp">
    <svg class="icon icon--lg" aria-hidden="true"><use href="#icon-whatsapp"/></svg>
  </a>
  <% } %>
</div>

<%- include('chatbot') %>

<%- include('icons') %>
<%- include('illustrations') %>
<script src="/js/main.js" defer></script>
<script src="/js/chatbot.js" defer></script>
